{
  "name": "@red-cup-engineering/execute-javascript-node-command-service",
  "version": "0.4.3-dev.0",
  "description": "Executes one exact typed program request without a shell and returns its complete immutable receipt; also executes a request with this process's own stdio inherited by the child for a delegate that must hand its live stdin/stdout/stderr connection straight to another program.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/execute-javascript-node-command-service.git"
  },
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": {
    ".": "./scripts/execute-javascript-node-command.mjs",
    "./with-inherited-stdio": "./scripts/execute-javascript-node-command-with-inherited-stdio.mjs",
    "./asynchronously": "./scripts/execute-javascript-node-command-asynchronously.mjs"
  },
  "bin": {
    "execute-javascript-node-command": "./scripts/execute-javascript-node-command.mjs"
  },
  "files": [
    "scripts",
    "package.json",
    "data/records/schema",
    "src",
    "test"
  ],
  "dependencies": {
    "@red-cup-engineering/node-js-function-engineering-services-section": "0.5.2-dev.0",
    "@red-cup-engineering/json-engineering-services-section": "0.4.3-dev.0",
    "@red-cup-engineering/signcell": "0.17.5"
  },
  "scripts": {
    "test": "run-package-tests",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts",
    "check": "check-package-syntax",
    "test:native-flock": "CODE_REQUIRE_NATIVE_FLOCK=1 node --test test/original-kernel-flock-descriptor.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@red-cup-engineering/jsonl-engineering-services-section": "^0.1.0",
    "@red-cup-engineering/jsnode-package-engineering-services-section": "^0.5.1-dev.5"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  },
  "receivingTests": [
    "test/execute-javascript-node-command-asynchronously.test.mjs",
    "test/execute-javascript-node-command-with-inherited-stdio.test.mjs",
    "test/execute-javascript-node-command.test.mjs",
    "test/execution-contract.test.mjs",
    "test/execution-receipt-settlement.test.mjs",
    "test/inherited-file-descriptors.test.mjs",
    "test/original-kernel-flock-descriptor.test.mjs",
    "test/installed-original-code-consumer.mjs"
  ]
}
